{
  "expo": {
    "name": "SiaMeal Snap",
    "slug": "siameal-snap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "siamealsnap",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.siamealsnap.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.siamealsnap.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SiaMeal Snap uses the camera to photograph your meals and scan barcodes so it can estimate their nutrition.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SiaMeal Snap opens your photo library so you can pick a meal photo to analyze. Photos are only used for nutrition estimates.",
          "cameraPermission": "SiaMeal Snap uses the camera to photograph your meals and scan barcodes so it can estimate their nutrition.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#10b981"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c06e36be-91f2-4bfd-bb46-c22f7681384f"
      }
    }
  }
}
